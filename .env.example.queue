# ==========================================
# 🚀 Laravel Queue + Mail Configuration
# ==========================================

# 📌 QUEUE CONFIGURATION
# ====================

# Database Queue (Mặc định)
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=sqlite
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90

# Redis Queue (Production - Uncomment để dùng)
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=null
# REDIS_QUEUE=default


# 📌 MAIL CONFIGURATION
# ====================

# Development (Log only)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production SMTP (Gmail)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tat.hasaki@gmail.com
# MAIL_PASSWORD=ytus hfjd tanh pybt
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=your-email@gmail.com
# MAIL_FROM_NAME="My App Name"

# Alternative: SendGrid
# MAIL_MAILER=sendgrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# Alternative: Mailgun
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_SECRET=key-xxxxxxxxxxxxx


# 📌 JOB CONFIGURATION
# ====================

# Job Timeout (giây) - Thời gian tối đa job được chạy
JOB_TIMEOUT=120

# Job Retries - Số lần thử
JOB_RETRIES=3

# Delay between retries (giây)
JOB_BACKOFF=10


# 📌 DATABASE CONFIGURATION
# ========================

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=


# 📌 CACHE & SESSION
# ==================

CACHE_STORE=database
SESSION_DRIVER=database
BROADCAST_CONNECTION=log


# 📌 LOGGING
# ==========

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ============================================================================
# MAIL CONFIGURATION FOR VNPAY ORDER COMPLETION EMAILS
# ============================================================================
# Thêm hoặc cập nhật các dòng sau vào file .env

# Option 1: Using Gmail (Recommended for Testing/Development)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourapp.com
MAIL_FROM_NAME="TTS Course Platform"

# How to get Gmail App Password:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Select app: Mail, device: Windows/Mac/Linux
# 3. Copy the generated password
# 4. Use that password as MAIL_PASSWORD

# ============================================================================
# Option 2: Using Other SMTP Providers
# ============================================================================

# Mailtrap (Development)
# MAIL_MAILER=smtp
# MAIL_HOST=live.smtp.mailtrap.io
# MAIL_PORT=587
# MAIL_USERNAME=your-mailtrap-username
# MAIL_PASSWORD=your-mailtrap-password
# MAIL_ENCRYPTION=tls

# SendGrid
# MAIL_MAILER=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key

# Mailgun
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=your-mailgun-domain
# MAILGUN_SECRET=your-mailgun-secret

# ============================================================================
# QUEUE CONFIGURATION (For Async Email Sending)
# ============================================================================
# Default: sync (send immediately)
# Options: sync, database, redis, beanstalkd

QUEUE_CONNECTION=database

# If using database queue:
# 1. Run: php artisan migrate
# 2. Run worker: php artisan queue:work
# 3. Or with supervisor/systemd for production

# ============================================================================
# VNPAY CONFIGURATION
# ============================================================================

VN_PAY_TMN_CODE=your_tmn_code
VN_PAY_HASH_SECRET=your_hash_secret
VN_PAY_URL=https://sandbox.vnpayment.vn/paygate

# Production URL: https://api.vnpayment.vn/paygate

# ============================================================================
# DEBUG LOGGING (Optional)
# ============================================================================
LOG_CHANNEL=stack
LOG_LEVEL=debug

# View logs at: storage/logs/laravel.log
